{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git pull",
            "shell": "bash",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git add -A; git diff --cached --quiet || git commit -m \"auto-sync\"; git push",
            "shell": "bash",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
